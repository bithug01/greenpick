# GreenPick configuration. Copy to .env. Defaults work offline, using typical values.

# Data source for grid carbon intensity: auto | mock | eia | entsoe | electricitymaps
#   auto  = route by region (US -> EIA, EU -> ENTSO-E, Canada -> Hydro-Quebec/IESO   <- recommended
#           live, Canada needs no key; typical fallback)
#   mock  = offline, no keys: each grid's typical value for this month, from    <- default
#           a year of real data (hand-set mock only where no source covers it)
GREENPICK_CARBON_SOURCE=mock

# --- Live data keys (both free; only needed if GREENPICK_CARBON_SOURCE is auto/eia/entsoe) ---
# EIA (US grid) — free, instant: https://www.eia.gov/opendata/
EIA_API_KEY=
# ENTSO-E (EU grid) — free: register at https://transparency.entsoe.eu/ then request API access.
ENTSOE_TOKEN=

# Electricity Maps token — optional/legacy path (GREENPICK_CARBON_SOURCE=electricitymaps).
# Not required for auto/EIA/ENTSO-E. Free tier: https://electricitymaps.com/free-tier
ELECTRICITYMAPS_TOKEN=

# How long to cache a region's carbon reading, in seconds (grid data changes ~hourly).
GREENPICK_CACHE_TTL_SECONDS=1800

# Log level: DEBUG | INFO | WARNING | ERROR
GREENPICK_LOG_LEVEL=INFO
